# 复制为 .env 并填写（.env 已被 .gitignore 排除）
# LLM 凭证二选一：

# ── 方式一：Anthropic 官方（默认，模型自动用 claude-opus-5-5）──
ANTHROPIC_API_KEY=sk-ant-xxxx

# ── 方式二：DeepSeek 的 Anthropic 兼容端点（用这个就把上面注释掉）──
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-xxxx
# ACTIVITY_MODEL=deepseek-v4-pro[1m]

# 飞书自定义机器人 webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# 飞书机器人加签密钥（安全设置没选"加签"则留空）
FEISHU_SECRET=
